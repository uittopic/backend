# Model Configuration
MODEL_NAME=Salesforce/blip-image-captioning-base
MODEL_PATH=models/blip_vietnamese_80_20
PRETRAINED_MODEL=Salesforce/blip-image-captioning-base

# Data Configuration
DATA_DIR=data

# Training Configuration
TRAIN_BATCH_SIZE=2
EVAL_BATCH_SIZE=2
NUM_EPOCHS=5
LEARNING_RATE=5e-5
WARMUP_STEPS=500
MAX_LENGTH=77

# API Configuration
API_TITLE=BLIP Vietnamese Captioning API
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# Generation Configuration
MAX_NEW_TOKENS=50
NUM_BEAMS=3
EARLY_STOPPING=true
NO_REPEAT_NGRAM_SIZE=3
REPETITION_PENALTY=1.2
MAX_IMAGE_SIZE=512

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=*

# Batch / Cache
MAX_BATCH_SIZE=10
ENABLE_CACHE=true
CACHE_TTL=86400

# Security / Rate limit
ENABLE_AUTH=false
API_KEYS=
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
